# VR Digital Calling — Environment Variables Reference
# Copy this file to .env and fill in real values.

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=vrdigital
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vrdigital_db

# DATABASE_URL is built automatically by docker-compose. Do not set manually.

# ─── Backend ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT — minimum 32 characters, use a long random string
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_very_long_random_secret_string_min_64_chars

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Platform-level OpenAI API key — used for all companies' AI sessions
OPENAI_API_KEY=sk-...

# ─── Twilio Platform Account ─────────────────────────────────────────────────
# Single Twilio account configured by the developer.
# Companies do NOT need their own Twilio accounts.
# Find these in: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── Demo Company ────────────────────────────────────────────────────────────
# The company that receives all incoming calls (MVP: single company routing).
# Get this value after running: npm run seed
# Then query: SELECT id, name FROM companies LIMIT 5;
DEMO_COMPANY_ID=cuid_of_your_registered_company

# ─── Frontend (Vite env vars must start with VITE_) ─────────────────────────
VITE_API_URL=http://localhost:4000/api
