# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=vrdigital
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vrdigital_db

# Automatically built from above by docker-compose (do not set manually in compose)
# DATABASE_URL=postgresql://vrdigital:change_me_in_production@postgres:5432/vrdigital_db

# ─── Backend ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT — use a long random string (min 64 chars)
JWT_SECRET=change_me_to_a_very_long_random_secret_string_min_64_chars

# Encryption key for Twilio Auth Tokens stored in DB
# Must be exactly 64 hex characters (= 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_64_hex_chars_0000000000000000000000000000000000000000

# ─── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Twilio (platform-level, for webhook validation helper) ─────────────────
# Individual company credentials are stored encrypted in the DB.
# This is your platform's own Twilio account (optional, for testing).
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# ─── Frontend (Vite env vars must start with VITE_) ─────────────────────────
VITE_API_URL=http://localhost:4000/api
